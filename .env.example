# bankmachine — local environment. Copy to `.env` and fill in.
#
#     cp .env.example .env
#     $EDITOR .env
#     source .env
#
# 🔴 Nothing loads this file automatically. The product reads process environment
# variables (and ~/.config/bankmachine/config.toml); it has no dotenv dependency,
# on purpose — a file that is silently read is a file whose contents are silently
# trusted. `source .env` in the shell you run `bankmachine` from, or move these
# values into the config file, where the same keys live without the prefix.
#
# Precedence, highest first: an explicit argument, these variables, the config
# file, the documented default. See src/bankmachine/config.py.
#
# 🔴 THE AGGREGATOR SECRET DOES NOT BELONG HERE. It goes in the OS keychain:
#
#     bankmachine connector set-secret     # prompts, does not echo
#
# There is no environment variable for it, and adding one would put a live
# credential into every process listing and shell history that touched it.

# --- required -------------------------------------------------------------

# 🔴 sandbox or production. REQUIRED by anything that opens the datastore for
# writing, or that changes a per-environment keychain entry -- which is most of
# the product, `store backup` and `store key import` included. Deliberately NOT
# listed command by command here: the rule is enforced at the two chokepoints
# every such write passes through, so a list written today is short tomorrow.
#
# It has a default (`sandbox`) and reads still use it -- `store status`,
# `connections list`, `sync shell`, the MCP server. A write refuses instead:
# every per-environment container is keyed on this value, and `set-secret` on a
# defaulted environment would overwrite the OTHER environment's secret while
# reporting success. There is no undo for that.
#
# 🔴 A cron or launchd entry sources nothing. Put it in
# ~/.config/bankmachine/config.toml as `environment = "sandbox"` instead, or the
# job exits 2 every night.
export BANKMACHINE_ENVIRONMENT=sandbox

# The aggregator client identifier. One value across environments; it is not the
# secret, but it is still yours, which is why it is configuration and not a literal.
#
# Every command that opens a connection to the aggregator needs it -- `connector
# check`, `enroll`, `sync run` and `connections retire` -- because they all build
# the same client, which refuses without one: "no aggregator client id is
# configured". The commands that only touch the local datastore (`store *`,
# `sync shell`, `mcp`) do not.
export BANKMACHINE_PLAID_CLIENT_ID=

# --- optional: everything below has a working default --------------------

# Default: $XDG_DATA_HOME/bankmachine/store-sandbox.db (production: store.db),
# falling back to ~/.local/share/bankmachine/.
# export BANKMACHINE_DATASTORE_PATH=

# How many live connections may exist at once (AC-1.5). Default 10, the aggregator
# plan tier. Configuration rather than a literal because plan tiers change -- and
# because the refusal has to come from here rather than from the aggregator,
# which would reject only AFTER you had completed a browser flow and minted a
# connection nobody can use. Retired connections do not count against it:
# `bankmachine connections retire <id>` frees a slot and keeps the history.
# export BANKMACHINE_CONNECTION_CAP=10

# 🔴 How much transaction history enrollment asks the aggregator to grant, in
# days. Default 730, which is the aggregator's own documented maximum.
#
# 🔴 READ AT EVERY ENROLLMENT, as of build step 3. `bankmachine enroll` passes
# this value to the aggregator, and `enroll` confirms it with you before the
# exchange because that is the last moment it can be corrected.
#
# This is immutable per connection once that connection is enrolled: changing it
# later moves nothing that already exists, it only changes what the NEXT
# enrollment asks for. Getting it wrong means re-linking every institution, so
# the default errs high on purpose -- asking for more history than you need
# costs nothing, asking for less costs history you cannot buy back.
# export BANKMACHINE_HISTORY_DAYS=730

# Default: $XDG_STATE_HOME/bankmachine/logs, falling back to ~/.local/state/.
# export BANKMACHINE_LOG_DIR=

# The keychain service every entry lives under. Default: bankmachine. There are
# three shapes of entry, not two: `datastore:<environment>` holds the key that
# decrypts the datastore, `plaid:<environment>` holds the aggregator secret, and
# `connection:<environment>:<item>` holds ONE access token per enrolled
# connection, written at each enrollment.
#
# 🔴 Changing this after enrolling orphans every access token. Nothing enumerates
# keychain entries, so no command can find them again under the old service and
# no command can migrate them: the only recovery is re-enrolling each
# institution, which mints new tokens and re-links every connection.
# export BANKMACHINE_KEYCHAIN_SERVICE=

# How long SQLite waits for a competing writer, in ms. Default: 5000.
# export BANKMACHINE_BUSY_TIMEOUT_MS=

# A config file other than ~/.config/bankmachine/config.toml.
# export BANKMACHINE_CONFIG=

# --- recording sandbox fixtures ------------------------------------------
#
# Only for `uv run pytest -m sandbox`, and only deliberately: it makes live
# sandbox calls and writes tests/connector/fixtures/. Leave it unset otherwise.
# export BANKMACHINE_RECORD_FIXTURES=1
